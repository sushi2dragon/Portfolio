# Copy to .env and fill in values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# bcrypt hash of your admin password (generate with: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)")
ADMIN_HASH=$2b$10$...

# JWT signing secret — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed frontend origins
# e.g. https://your-app.vercel.app,http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cloudinary credentials (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
